#!/bin/sh
# Container entrypoint (runs under tini). The image carries no browser:
# Playwright MCP (testing, screenshots) runs in its own pod. tini forwards
# signals, so dsh can simply replace this shell.
set -eu

exec node --expose-internals \
  /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js \
  "$@"
